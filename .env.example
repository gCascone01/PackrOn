GEMINI_API_KEY=your_gemini_api_key_here
# Opzionale: override modello (default gemini-3.1-flash-lite)
# GEMINI_MODEL=gemini-3.1-flash-lite
# ID affiliato Booking.com — omesso finché resta YOUR_ID
# NEXT_PUBLIC_BOOKING_AFFILIATE_ID=
# Partner GetYourGuide (opzionale)
# NEXT_PUBLIC_GETYOURGUIDE_PARTNER_ID=
# Cartella per i link corti di condivisione (default: .data/shares in locale, /tmp su Vercel)
# PACKRON_SHARE_DIR=

# Supabase Auth + Postgres (login + salvataggio viaggi)
# Prendi questi valori da Supabase Dashboard → Project Settings → API.
# La chiave pubblica è sicura da esporre by design (i permessi reali li danno
# le RLS policy); usa la NUOVA chiave "publishable" (sb_publishable_...), con
# fallback alla legacy "anon" se necessario. Non aggiungere MAI qui o nel
# client la SECRET o SERVICE_ROLE KEY.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
# Legacy fallback (in alternativa alla publishable):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# URL pubblico del sito (REQUIRED in produzione: i link nelle email di
# conferma usano questo valore; senza, puntano all'origin corrente e Supabase
# li scarta se non è nella allowlist, ricadendo sulla Site URL di dashboard)
# NEXT_PUBLIC_SITE_URL=https://packron.vercel.app