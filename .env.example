GEMINI_API_KEY=your_gemini_api_key_here
# Opzionale: override modello (default gemini-3.1-flash-lite)
# GEMINI_MODEL=gemini-3.1-flash-lite
# ID affiliato Booking.com — omesso finché resta YOUR_ID
# NEXT_PUBLIC_BOOKING_AFFILIATE_ID=
# Partner GetYourGuide (opzionale)
# NEXT_PUBLIC_GETYOURGUIDE_PARTNER_ID=
# Cartella per i link corti di condivisione (default: .data/shares in locale, /tmp su Vercel)
# PACKRON_SHARE_DIR=